<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MRC Compact Stage</name>
  <width>210</width>
  <height>282</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>SECTION</class>
    <text>$(R)</text>
    <font use_class="true">
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="slide_button" version="2.0.0">
    <name>SetHold</name>
    <label>Set &amp; Hold</label>
    <y>20</y>
    <width>210</width>
    <enabled>false</enabled>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>StartSetHoldButton</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(P)$(R)StartSetAndHold</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Start Set &amp; Hold</text>
    <y>50</y>
    <width>110</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>ClearSetHoldButton</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(P)$(R)ClearSetAndHold</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Clear Set &amp; Hold</text>
    <y>90</y>
    <width>110</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="byte_monitor" version="2.0.0">
    <name>StatusFlag</name>
    <pv_name>$(P)GetStatusFlag</pv_name>
    <x>120</x>
    <y>30</y>
    <width>90</width>
    <height>160</height>
    <bitReverse>true</bitReverse>
    <horizontal>false</horizontal>
    <labels>
      <text>PF</text>
      <text>Adj1</text>
      <text>Adj2</text>
      <text>OnOff1</text>
      <text>OnOff2</text>
      <text>A1</text>
      <text>A2</text>
      <text>EF</text>
    </labels>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Adjust-in</name>
    <y>130</y>
    <width>120</width>
    <height>76</height>
    <transparent>true</transparent>
    <tooltip>Align the laser beam on detector</tooltip>
    <widget type="textupdate" version="2.0.0">
      <name>AdjustX</name>
      <pv_name>$(P)$(R)AdjustInX</pv_name>
      <x>20</x>
      <width>62</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>AdjustY</name>
      <pv_name>$(P)$(R)AdjustInY</pv_name>
      <x>20</x>
      <y>20</y>
      <width>62</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>AdjustXLabel</name>
      <text>X</text>
      <width>10</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>AdjustYLabel</name>
      <text>Y</text>
      <y>20</y>
      <width>10</width>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Drive Mirror</name>
    <y>206</y>
    <width>120</width>
    <height>76</height>
    <transparent>true</transparent>
    <tooltip>Drive mirror directly</tooltip>
    <widget type="textupdate" version="2.0.0">
      <name>DriveMirrorX</name>
      <pv_name>$(P)$(R)DriveMirrorX</pv_name>
      <x>20</x>
      <width>62</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>DriveMirrorY</name>
      <pv_name>$(P)$(R)DriveMirrorY</pv_name>
      <x>20</x>
      <y>20</y>
      <width>62</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>DriveMirrorXLabel</name>
      <text>X</text>
      <width>10</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>DriveMirrorYLabel</name>
      <text>Y</text>
      <y>20</y>
      <width>10</width>
    </widget>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <y>211</y>
    <width>120</width>
    <height>64</height>
    <line_width>0</line_width>
    <background_color>
      <color red="0" green="0" blue="0" alpha="60">
      </color>
    </background_color>
  </widget>
</display>
