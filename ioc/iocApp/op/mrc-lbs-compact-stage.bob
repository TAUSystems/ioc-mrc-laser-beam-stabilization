<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MRC Compact Stage</name>
  <width>190</width>
  <height>230</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>SECTION</class>
    <text>$(R)</text>
    <font use_class="true">
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Set &amp; Hold</name>
    <y>20</y>
    <width>190</width>
    <height>68</height>
    <transparent>true</transparent>
    <widget type="action_button" version="3.0.0">
      <name>StartSetHoldButton</name>
      <actions>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P)$(R)StartSetAndHold</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Start</text>
      <width>72</width>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ClearSetHoldButton</name>
      <actions>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P)$(R)ClearSetAndHold</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Clear</text>
      <x>82</x>
      <width>72</width>
      <tooltip>$(actions)</tooltip>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Adjust-in</name>
    <y>78</y>
    <width>190</width>
    <height>76</height>
    <transparent>true</transparent>
    <tooltip>Align the laser beam on detector</tooltip>
    <widget type="label" version="2.0.0">
      <name>AdjustInXLabel</name>
      <text>X</text>
      <width>10</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>AdjustInX</name>
      <pv_name>$(P)$(R)AdjustInX</pv_name>
      <x>12</x>
      <width>70</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>AdjustInX_RBV</name>
      <pv_name>$(P)$(R)AdjustInX_RBV</pv_name>
      <x>87</x>
      <width>70</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>AdjustInYLabel</name>
      <text>Y</text>
      <y>20</y>
      <width>10</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>AdjustInY</name>
      <pv_name>$(P)$(R)AdjustInY</pv_name>
      <x>12</x>
      <y>20</y>
      <width>70</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>AdjustInY_RBV</name>
      <pv_name>$(P)$(R)AdjustInY_RBV</pv_name>
      <x>87</x>
      <y>20</y>
      <width>70</width>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Drive Mirror</name>
    <y>154</y>
    <width>190</width>
    <height>76</height>
    <transparent>true</transparent>
    <tooltip>Drive piezo actuators directly while stabilization off</tooltip>
    <widget type="label" version="2.0.0">
      <name>DriveMirrorXLabel</name>
      <text>X</text>
      <width>10</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>DriveMirrorX</name>
      <pv_name>$(P)$(R)DriveMirrorX</pv_name>
      <x>12</x>
      <width>70</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>DriveMirrorX_RBV</name>
      <pv_name>$(P)$(R)DriverMirrorX_RBV</pv_name>
      <x>87</x>
      <width>70</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>DriveMirrorYLabel</name>
      <text>Y</text>
      <y>20</y>
      <width>10</width>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>DriveMirrorY</name>
      <pv_name>$(P)$(R)DriveMirrorY</pv_name>
      <x>12</x>
      <y>20</y>
      <width>70</width>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>DriveMirrorY_RBV</name>
      <pv_name>$(P)$(R)DriveMirrorY_RBV</pv_name>
      <x>87</x>
      <y>20</y>
      <width>70</width>
    </widget>
  </widget>
</display>
