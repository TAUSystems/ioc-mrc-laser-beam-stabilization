<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MRC Compact</name>
  <width>460</width>
  <height>282</height>
  <widget type="template" version="2.0.0">
    <name>StageInstances</name>
    <file>mrc-lbs-compact-stage.bob</file>
    <instances>
      <instance>
        <macros>
          <P>$(P)</P>
          <R>$(R1)</R>
        </macros>
      </instance>
      <instance>
        <macros>
          <P>$(P)</P>
          <R>$(R2)</R>
        </macros>
      </instance>
    </instances>
    <width>390</width>
    <height>282</height>
    <horizontal>true</horizontal>
  </widget>
  <widget type="label" version="2.0.0">
    <name>StatusLabel</name>
    <class>SECTION</class>
    <text>Status</text>
    <x>390</x>
    <width>70</width>
    <font use_class="true">
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="byte_monitor" version="2.0.0">
    <name>StatusFlag</name>
    <pv_name>$(P)GetStatusFlag</pv_name>
    <x>390</x>
    <y>20</y>
    <width>70</width>
    <height>160</height>
    <bitReverse>true</bitReverse>
    <horizontal>false</horizontal>
    <labels>
      <text>PF</text>
      <text>Adj1</text>
      <text>Adj2</text>
      <text>OnOff1</text>
      <text>OnOff2</text>
      <text>A1</text>
      <text>A2</text>
      <text>EF</text>
    </labels>
  </widget>
</display>
